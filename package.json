{
  "name": "uleszka-archiwum",
  "version": "1.3.0",
  "description": "Archiwum serwisu uleszka.net (teksty bez zmian) z serwerem MCP do rozmowy z AI",
  "type": "module",
  "bin": {
    "uleszka-mcp": "dist/server.js"
  },
  "main": "dist/server.js",
  "scripts": {
    "test": "tsx scripts/test-mcp.ts && tsx scripts/test-mcp.ts --http",
    "konwertuj": "tsx scripts/konwertuj.ts",
    "sprawdz": "tsx scripts/sprawdz.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "prepare": "tsc -p .",
    "pakiety": "tsx scripts/pakiety.ts",
    "biblioteka": "tsx scripts/biblioteka.ts",
    "wektory": "tsx scripts/wektory.ts",
    "sprawdz-opracowania": "tsx scripts/sprawdz-opracowania.ts",
    "czytelnia": "tsx scripts/czytelnia.ts",
    "strona": "tsx scripts/strona-zdjecia.ts && tsx scripts/obrazek-strony.ts && tsx scripts/czytelnia.ts",
    "literowki": "tsx scripts/literowki.ts",
    "errata": "tsx scripts/errata.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "archiwum",
    "uleszka"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jokerwader/uleszka-archiwum.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "minisearch": "^7.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "cheerio": "^1.2.0",
    "dictionary-pl": "^2.0.0",
    "marked": "^18.2.0",
    "nspell": "^2.1.5",
    "tsx": "^4.23.15",
    "turndown": "^7.2.5",
    "typescript": "^7.0.2"
  }
}
