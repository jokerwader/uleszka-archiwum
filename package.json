    "minisearch": "^7.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "cheerio": "^1.2.0",
    "tsx": "^4.23.15",
    "turndown": "^7.2.5",
    "typescript": "^7.0.2"
  }
