  "description": "Archiwum serwisu uleszka.net (teksty bez zmian) z serwerem MCP do rozmowy z AI",
  "type": "module",
  "bin": {
    "uleszka-mcp": "dist/server.js"
  },
  "main": "dist/server.js",
  "scripts": {
    "test": "tsx scripts/test-mcp.ts && tsx scripts/test-mcp.ts --http",
